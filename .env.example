# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Next Auth Secret (isi dengan random string panjang, generate: openssl rand -base64 32)
AUTH_SECRET="your-random-secret"

# Domain publik website. Dipakai untuk canonical URL, sitemap.xml, robots.txt, dan preview
# link di media sosial. Ganti nilai ini saat pindah ke domain baru — tanpa ubah kode.
# Tanpa trailing slash. Kalau kosong, fallback ke https://pc-kmhdi-malang-web.vercel.app
NEXT_PUBLIC_SITE_URL="https://pc-kmhdi-malang-web.vercel.app"
