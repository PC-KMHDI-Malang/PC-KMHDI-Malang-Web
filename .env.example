# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare R2 (storage file). Kalau salah satu kosong, upload tetap ke Supabase Storage.
# R2_ACCOUNT_ID: Cloudflare Dashboard > R2 > Account ID. Kunci dari "Manage R2 API Tokens"
# (izin Object Read & Write untuk kedua bucket di bawah).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Bucket publik untuk gambar, dan bucket privat untuk PDF e-book (jangan diberi akses publik).
R2_PUBLIC_BUCKET="kmhdi-media"
R2_PRIVATE_BUCKET="kmhdi-ebook-files"
# Custom domain yang terhubung ke bucket publik, tanpa trailing slash.
NEXT_PUBLIC_R2_PUBLIC_URL="https://media.kmhdimalang.org"

# Next Auth Secret (isi dengan random string panjang, generate: openssl rand -base64 32)
AUTH_SECRET="your-random-secret"

# Domain publik website. Dipakai untuk canonical URL, sitemap.xml, robots.txt, dan preview
# link di media sosial. Ganti nilai ini saat pindah ke domain baru — tanpa ubah kode.
# Tanpa trailing slash. Kalau kosong, fallback ke https://pc-kmhdi-malang-web.vercel.app
NEXT_PUBLIC_SITE_URL="https://pc-kmhdi-malang-web.vercel.app"

# Domain sistem (login, panel admin, uang kas, profil akun). Kalau diisi, halaman-halaman itu
# otomatis dipindah ke domain ini dan halaman publik tetap di NEXT_PUBLIC_SITE_URL (lihat
# lib/appHost.ts). Kosongkan untuk localhost / preview — semuanya tetap di satu domain.
NEXT_PUBLIC_APP_URL=""
# Supaya status login berlaku di domain publik DAN domain sistem sekaligus. Isi dengan domain
# induk diawali titik, mis. ".kmhdimalang.org". Kosongkan untuk localhost.
AUTH_COOKIE_DOMAIN=""

# Saklar Google AdSense. Set "false" untuk mematikan iklan tanpa perlu ubah kode/deploy ulang.
NEXT_PUBLIC_ADS_ENABLED="true"

# Notifikasi agenda (lib/notify). Lonceng di navbar selalu jalan; email hanya aktif kalau
# RESEND_API_KEY dan RESEND_FROM terisi. RESEND_FROM harus alamat di domain yang sudah
# diverifikasi (SPF/DKIM) di dashboard Resend, mis. "PC KMHDI Malang <agenda@kmhdimalang.org>".
RESEND_API_KEY=""
RESEND_FROM=""
# Rahasia untuk endpoint cron pengingat H-1 (/api/cron/agenda-reminder). Wajib diisi di
# produksi — tanpa ini endpoint menolak semua permintaan. Vercel otomatis mengirimnya sebagai
# "Authorization: Bearer ..." saat menjalankan cron. Generate: openssl rand -base64 32
CRON_SECRET=""
# Isi "1" untuk mencoba tanpa mengirim apa pun: hanya mencatat berapa penerima yang akan dikirimi.
NOTIFY_DRY_RUN=""
# Kalau diisi, notifikasi hanya berupa SATU email contoh ke alamat ini (bukan ke anggota), tanpa
# menyentuh lonceng. Untuk mencoba tampilan email dengan aman.
NOTIFY_TEST_RECIPIENT=""

# Grup WhatsApp lewat Fonnte (https://fonnte.com): SATU pesan per kejadian ke SATU grup, jadi
# kuota paket gratis (1.000 pesan/bulan) sangat longgar. FONNTE_TOKEN dari dashboard perangkat;
# FONNTE_GROUP_ID berformat "123456789@g.us" (lihat docs.fonnte.com/get-whatsapp-group-id), dan
# nomor yang tersambung ke Fonnte harus sudah menjadi anggota grup itu. Kosongkan salah satunya
# untuk mematikan kanal ini. Catatan: Fonnte bukan API resmi WhatsApp — pakai nomor khusus; paket
# gratis menambahkan watermark di setiap pesan.
FONNTE_TOKEN=""
FONNTE_GROUP_ID=""
# Kalau diisi (nomor 08xx atau id grup), pesan WhatsApp contoh dikirim ke sini, BUKAN ke grup.
NOTIFY_TEST_WA_TARGET=""
